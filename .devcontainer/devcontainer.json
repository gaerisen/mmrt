{
  "name": "ROS 2 Jazzy on Ubuntu 24.04",

  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "remoteUser": "vscode",
  "containerUser": "vscode",

  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "init": true,

  "runArgs": [
    "--network=host"
  ],

  "mounts": [
    "source=/var/run/docker.sock,target=/run/docker.sock,type=bind",
    "type=bind,source=${env:HOME}/.Xauthority,target=/home/vscode/.Xauthority",
    "type=bind,source=/tmp/.X11-unix,target=/tmp/.X11-unix"
  ],

  "remoteEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-vscode.cpptools",
        "ms-python.python",
        "twxs.cmake",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "cmake.configureOnOpen": false
      }
    }
  },

  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/althack/devcontainers/linux-x11-forwarding:0.4.0": {}
  }
}
